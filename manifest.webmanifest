{
 "id": "./",
 "name": "ASC 베이 플랜 뷰어",
 "short_name": "ASC 뷰어",
 "description": "CASP 스토이지 플랜(.asc)을 바로 여는 뷰어",
 "lang": "ko",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "orientation": "any",
 "background_color": "#bdbdbd",
 "theme_color": "#000080",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png"
  },
  {
   "src": "icon-512-mask.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "share_target": {
  "action": "./share",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "files": [
    {
     "name": "file",
     "accept": [
      "*/*",
      ".asc",
      "application/octet-stream",
      "text/plain",
      "application/pgp-signature",
      "application/pgp-keys"
     ]
    }
   ]
  }
 },
 "file_handlers": [
  {
   "action": "./",
   "accept": {
    "application/octet-stream": [
     ".asc"
    ],
    "text/plain": [
     ".asc"
    ]
   }
  }
 ]
}
